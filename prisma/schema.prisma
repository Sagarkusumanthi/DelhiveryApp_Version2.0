generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model City {
  id        String      @id
  name      String      @unique
  isActive  Boolean     @default(true)
  GroupGift GroupGift[]
  Order     Order[]
  stores    Store[]
}

model Category {
  id        String    @id
  name      String    @unique
  slug      String    @unique
  icon      String    @default("Gift")
  sortOrder Int       @default(0)
  Product   Product[]
  Store     Store[]
}

enum ModerationStatus {
  PENDING
  APPROVED
  BLOCKED
}

model Store {
  id               String           @id
  ownerUserId      String
  categoryId       String
  cityId           String
  name             String
  description      String
  address          String
  coverImage       String
  isOpen           Boolean          @default(true)
  moderationStatus ModerationStatus @default(APPROVED)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime
  openTime         String           @default("09:00")
  closeTime        String           @default("21:00")
  Order            Order[]
  products         Product[]
  Category         Category         @relation(fields: [categoryId], references: [id])
  city             City             @relation(fields: [cityId], references: [id])
  User             User             @relation(fields: [ownerUserId], references: [id])
  @@index([cityId])
  @@index([ownerUserId])
}

model Product {
  id            String          @id
  storeId       String
  categoryId    String
  name          String
  description   String
  price         Decimal         @db.Decimal(10, 2)
  imageUrl      String
  isAvailable   Boolean         @default(true)
  isFeatured    Boolean         @default(false)
  isArchived    Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  CartItem      CartItem[]
  GroupGiftItem GroupGiftItem[]
  orderItems    OrderItem[]
  Category      Category        @relation(fields: [categoryId], references: [id])
  store         Store           @relation(fields: [storeId], references: [id])
  @@index([storeId])
  @@index([categoryId])
}

enum Role {
  CUSTOMER
  STORE_OWNER
  ADMIN
}

model User {
  id                 String               @id @default(cuid())
  name               String
  email              String               @unique
  passwordHash       String
  role               Role
  createdAt          DateTime             @default(now())
  phone              String?              @unique
  CartItem           CartItem[]
  GroupGift          GroupGift[]
  orders             Order[]
  OrderStatusHistory OrderStatusHistory[]
  Reminder           Reminder[]
  Store              Store[]
  @@index([role])
}

enum OrderStatus {
  ORDER_PLACED
  STORE_ACCEPTED
  PREPARING_GIFT
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  REJECTED
}

enum DeliveryOption {
  STANDARD
  EXPRESS
  SCHEDULED
}

enum PaymentMethod {
  COD
  UPI_MOCK
}

enum DeliverySlot {
  MORNING
  AFTERNOON
  EVENING
}

model Order {
  id                          String               @id @default(cuid())
  orderCode                   String               @unique
  customerId                 String
  storeId                     String
  cityId                      String
  status                      OrderStatus          @default(ORDER_PLACED)
  recipientName              String
  recipientPhone             String
  deliveryAddress            String
  landmark                   String?
  pincode                    String?
  senderName                 String
  occasion                   String
  giftMessage                String?
  deliveryOption             DeliveryOption
  deliveryDate               DateTime?
  deliverySlot               DeliverySlot?
  paymentMethod              PaymentMethod
  subtotal                   Decimal              @db.Decimal(10, 2)
  deliveryFee                Decimal              @db.Decimal(10, 2)
  total                      Decimal              @db.Decimal(10, 2)
  rejectionReason            String?
  proofImage                 String?
  idempotencyKey             String               @unique
  version                    Int                  @default(1)
  placedAt                   DateTime             @default(now())
  updatedAt                  DateTime
  deliveryConfirmedByCustomer Boolean              @default(false)
  City                        City                 @relation(fields: [cityId], references: [id])
  customer                    User                 @relation(fields: [customerId], references: [id])
  Store                       Store                @relation(fields: [storeId], references: [id])
  items                       OrderItem[]
  OrderStatusHistory          OrderStatusHistory[]
  @@index([customerId])
  @@index([status])
  @@index([cityId])
  @@index([storeId])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String
  productName String
  unitPrice   Decimal @db.Decimal(10, 2)
  quantity    Int
  lineTotal   Decimal @db.Decimal(10, 2)
  order       Order   @relation(fields: [orderId], references: [id])
  product     Product @relation(fields: [productId], references: [id])
  @@index([orderId])
  @@index([productId])
}

enum OccasionType {
  BIRTHDAY
  ANNIVERSARY
  WEDDING
  FESTIVAL
  OTHER
}

model Reminder {
  id            String       @id @default(cuid())
  customerId    String
  occasionName  String
  recipientName String
  occasionType  OccasionType
  date          DateTime
  repeatYearly  Boolean      @default(false)
  remindMe      String
  giftCategory  String?
  note          String?
  giftPlanned   Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime
  User          User         @relation(fields: [customerId], references: [id])
  @@index([customerId])
}

enum SplitType {
  EQUAL
  CUSTOM
}

model GroupGift {
  id            String                 @id @default(cuid())
  createdById   String
  title         String
  occasionType  OccasionType
  recipientName String
  cityId        String
  deliveryDate  DateTime
  goalAmount    Decimal                @db.Decimal(10, 2)
  splitType     SplitType              @default(EQUAL)
  message       String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime
  City          City                   @relation(fields: [cityId], references: [id])
  User          User                   @relation(fields: [createdById], references: [id])
  contributors  GroupGiftContributor[]
  GroupGiftItem GroupGiftItem[]
  @@index([createdById])
}

model GroupGiftContributor {
  id          String    @id @default(cuid())
  groupGiftId String
  name        String
  amount      Decimal   @db.Decimal(10, 2)
  paid        Boolean   @default(false)
  createdAt   DateTime  @default(now())
  groupGift   GroupGift @relation(fields: [groupGiftId], references: [id])
  @@index([groupGiftId])
}

model CartItem {
  id         String   @id
  customerId String
  productId  String
  quantity   Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  User       User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  Product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([customerId, productId])
  @@index([customerId])
  @@index([productId])
}

model GroupGiftItem {
  id         String    @id
  groupGiftId String
  productId  String
  GroupGift   GroupGift @relation(fields: [groupGiftId], references: [id])
  Product     Product   @relation(fields: [productId], references: [id])
  @@index([groupGiftId])
}

model OrderStatusHistory {
  id              String       @id
  orderId         String
  previousStatus  OrderStatus?
  status          OrderStatus
  changedById     String?
  changedByRole   Role
  note            String?
  isAdminOverride Boolean      @default(false)
  isSkipped       Boolean      @default(false)
  changedAt       DateTime     @default(now())
  User            User?        @relation(fields: [changedById], references: [id])
  Order           Order        @relation(fields: [orderId], references: [id])
  @@index([orderId])
}
