generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER
  STORE_OWNER
  ADMIN
}

enum OrderStatus {
  ORDER_PLACED
  STORE_ACCEPTED
  PREPARING_GIFT
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  REJECTED
}

enum DeliveryOption {
  STANDARD
  EXPRESS
  SCHEDULED
}

enum PaymentMethod {
  CARD
  UPI
  COD
}

model City {
  id         String      @id
  name       String
  stores     Store[]
  groupGifts GroupGift[]
}

model Category {
  id   String @id
  name String
  icon String
}

model Store {
  id          String    @id
  name        String
  category    String
  icon        String
  cityId      String
  city        City      @relation(fields: [cityId], references: [id])
  open        Boolean   @default(true)
  openTime    String    @default("09:00")
  closeTime   String    @default("21:00")
  address     String?
  description String?
  owner       String
  products    Product[]
  staff       User[]

  @@index([cityId])
  @@index([category])
}

model Product {
  id          String      @id
  storeId     String
  store       Store       @relation(fields: [storeId], references: [id])
  name        String
  price       Int
  icon        String
  featured    Boolean     @default(false)
  isAvailable Boolean     @default(true)
  description String?
  orderItems  OrderItem[]

  @@index([storeId])
}

model User {
  id        String     @id @default(cuid())
  name      String
  email     String     @unique
  phone     String?
  password  String
  role      Role
  storeId   String?
  store     Store?     @relation(fields: [storeId], references: [id])
  orders    Order[]
  reminders Reminder[]
}

model Order {
  id                          String              @id @default(cuid())
  code                        String              @unique
  customerId                  String
  customer                    User                @relation(fields: [customerId], references: [id])
  status                      OrderStatus         @default(ORDER_PLACED)
  recipientName               String
  recipientPhone              String
  recipientAddress            String
  occasion                    String?
  message                     String?
  sender                      String?
  deliveryOption              DeliveryOption
  paymentMethod               PaymentMethod
  total                       Int
  rejectionReason             String?
  deliveryConfirmedByCustomer Boolean             @default(false)
  deliveryPhotoDataUrl        String?             @db.Text
  createdAt                   DateTime            @default(now())
  items                       OrderItem[]
  history                     OrderHistoryEntry[]

  @@index([customerId])
  @@index([status])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id])
  productId    String
  product      Product @relation(fields: [productId], references: [id])
  qty          Int
  priceAtOrder Int

  @@index([orderId])
}

model OrderHistoryEntry {
  id       String   @id @default(cuid())
  orderId  String
  order    Order    @relation(fields: [orderId], references: [id])
  status   String
  at       DateTime @default(now())
  role     String?
  reason   String?
  override Boolean  @default(false)

  @@index([orderId])
}

model Reminder {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  occasionName  String
  recipientName String
  occasionType  String
  date          DateTime
  repeatYearly  Boolean  @default(false)
  remindMe      String
  giftCategory  String?
  note          String?
  giftPlanned   Boolean  @default(false)

  @@index([userId])
}

model GroupGift {
  id             String                 @id
  title          String
  occasionType   String
  recipientName  String
  deliveryCityId String
  deliveryCity   City                   @relation(fields: [deliveryCityId], references: [id])
  deliveryDate   DateTime
  goalAmount     Int
  splitType      String
  message        String?
  productIds     String[]
  contributors   GroupGiftContributor[]

  @@index([deliveryCityId])
}

model GroupGiftContributor {
  id          String    @id @default(cuid())
  groupGiftId String
  groupGift   GroupGift @relation(fields: [groupGiftId], references: [id])
  name        String
  amount      Int
  paid        Boolean   @default(false)

  @@index([groupGiftId])
}
